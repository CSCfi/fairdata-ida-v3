SCRIPT=`basename "$(realpath $0)"`

USAGE="
Usage: $SCRIPT [PID_LIST_FILE] [--json] [--relations]
       $SCRIPT -h

       PID_LIST_FILE   a file containing a listing of the frozen file pids to check, one per line
                       (if not specified, list taken from stdin)
       --json           output results as JSON, as an array of dataset identifiers if --relations not specified
       --relations      group results by file identifier, listing all datasets the file belongs to
"

PROJECT="null"

#--------------------------------------------------------------------------------
# Initialize script with common definitions

INIT_FILE=`dirname $0`/lib/init_appsupport_script.sh

if [ -e $INIT_FILE ]
then
    . $INIT_FILE
else
    echo "The initialization file $INIT_FILE cannot be found. Aborting." >&2
    exit 1
fi

FILE=$(echo "$1" | grep -v -- "--json" | grep -v -- "--relations")
JSON=$(echo "$*" | grep -- "--json")
RELATIONS=$(echo "$*" | grep -- "--relations")

if [ "$RELATIONS" ]; then
    RELATIONS="true"
else
    RELATIONS="false"
fi

#--------------------------------------------------------------------------------
# Process command line arguments

PID_LIST_JSON="/tmp/$$.pid_list.json"
trap 'rm -f "$PID_LIST_JSON"' EXIT

if [ "$FILE" ]; then
    if [ ! -f "$FILE" ]; then
        errorExit "Invalid file pathname $FILE"
    fi
    cat "$FILE" | jq -R 'select(length > 0)' | jq -s .  > "$PID_LIST_JSON"
else
    cat | jq -R 'select(length > 0)' | jq -s .  > "$PID_LIST_JSON"
fi

#--------------------------------------------------------------------------------

URL="${METAX_API}/files/datasets?storage_service=ida&relations=${RELATIONS}"

OUT=$($CURL_POST -H "$METAX_AUTH_HEADER" -H "Content-Type: application/json" "$URL" --data-binary @"$PID_LIST_JSON" 2>"$ERR")

if [ -s $ERR ]; then
    MSG=`cat $ERR`
    addToLog "$MSG"
    errorExit "Failed to check for dataset intersections in Metax"
fi

if [ "$JSON" ]; then
    echo "$OUT" | \
        jq --indent 4
else
    echo "$OUT" | \
        jq -r '
            if type == "string" then
                fromjson
            else
                .
            end
            | if '"$RELATIONS"' then
                to_entries[] | .key as $k | .value[] | "\($k) \(.)"
              else
                .[]
              end'
fi

addToLog "DONE"
