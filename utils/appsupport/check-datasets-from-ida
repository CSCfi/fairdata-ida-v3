SCRIPT=`basename "$(realpath $0)"`

USAGE="
Usage: $SCRIPT PROJECT PATHNAME [--json]
       $SCRIPT -h

       PROJECT    the project name
       PATHNAME   a relative pathname within the frozen area
       --json     output dataset identifiers as JSON array

       Pathname may correspond to either a file or a folder. 
"

#--------------------------------------------------------------------------------
# Initialize script with common definitions

INIT_FILE=`dirname $0`/lib/init_appsupport_script.sh

if [ -e $INIT_FILE ]
then
    . $INIT_FILE
else
    echo "The initialization file $INIT_FILE cannot be found. Aborting." >&2
    exit 1
fi

#--------------------------------------------------------------------------------
# Process command line arguments

if [ "$#" -lt 2 ]; then
    echo "$USAGE" >&2
    errorExit "Invalid number of arguments"
fi

PATHNAME="$2"
JSON=$(echo "$*" | grep -- "--json")

#--------------------------------------------------------------------------------

ENCODED_PATHNAME=$(urlEncode "${PATHNAME}")

URL="${IDA_API}/datasets?project=${PROJECT}&pathname=${ENCODED_PATHNAME}&token=${BATCH_ACTION_TOKEN}"

OUT=$($CURL_POST $PROJECT_USER_CREDENTIALS -H "$IDA_MODE_HEADER" "$URL" 2>$ERR)

if [ -s $ERR ]; then
    MSG=`cat $ERR`
    addToLog "$MSG"
    errorExit "Dataset intersection check failed for pathname $PATHNAME in project $PROJECT"
fi

if [ "$JSON" ]; then
    echo "$OUT" | jq --indent 4
else
    echo "$OUT" | jq -r '.[].pid' | sort -u
fi

addToLog "DONE"
