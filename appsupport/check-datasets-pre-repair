#--------------------------------------------------------------------------------
# This script will check if there are any datasets which will be affected
# (deprecated) by a repair process run against a particular audit error
# report, due to frozen files being reported as removed to Metax.
#--------------------------------------------------------------------------------

SCRIPT=`basename "$(realpath $0)"`
PROJECT="null"

USAGE="
Usage: $SCRIPT ERROR_FILE [--json]
       $SCRIPT -h

       ERROR_FILE  the pathname of an audit error file
       --json      output results as JSON, as an array of dataset identifiers
"

ERROR_FILE="$1"

if [ -z "$ERROR_FILE" ]; then
    errorExit "Missing audit error file"
fi

if [ ! -f "$ERROR_FILE" ]; then
    errorExit "Invalid audit error file $ERROR_FILE"
fi

JSON=$(echo "$2" | grep -- "--json")

#--------------------------------------------------------------------------------
# Initialize script with common definitions

INIT_FILE=`dirname $0`/lib/init_appsupport_script.sh

if [ -e $INIT_FILE ]
then
    . $INIT_FILE
else
    echo "The initialization file $INIT_FILE cannot be found. Aborting." >&2
    exit 1
fi

#--------------------------------------------------------------------------------

if [ "$DEBUG" = "true" ]; then
    echo "Extracting PIDs of frozen files which will be reported as removed to Metax..."
fi

PID_LIST="/tmp/$$.pid_list"
trap 'rm -f "$PID_LIST"' EXIT

cat "$ERROR_FILE" | \
    jq -r '
        .invalidNodes[]
        | select(
        (.ida.type == "file")
        and
        ((.errors | index("Node does not exist in filesystem"))
        or
        (.errors | index("Node does not exist in Nextcloud")))
        )
        | .ida.pid' \
    > "$PID_LIST"

if [ -s $ERR ]; then
    MSG=`cat $ERR`
    addToLog "$MSG"
    errorExit "Failed to extract frozen file PIDs from audit error report"
fi

if [ "$DEBUG" = "true" ]; then
    echo "Frozen file PIDS:"
    cat "$PID_LIST"
    echo "Checking for dataset intersections with frozen file PIDs..."
fi

cat "$PID_LIST" | DEBUG="false" $ROOT/appsupport/check-datasets-from-metax $JSON 2>$ERR >$OUT

if [ -s $ERR ]; then
    MSG=`cat $ERR`
    addToLog "$MSG"
    errorExit "Failed to check for dataset intersections from Metax"
fi

if [ -s $OUT ]; then
    if [ "$DEBUG" = "true" ]; then
        echo "The following datasets will be deprecated:"
    fi
    cat $OUT
else
    if [ "$DEBUG" = "true" ]; then
        echo "No datasets will be affected"
    fi
fi

addToLog "DONE"
