#!/bin/bash

IDA_ROOT="/usr/local/fd/ida-fairdata-v3"

if [ ! -d "$IDA_ROOT" ]; then
    IDA_ROOT="/var/ida"
fi

if [ ! -d "$IDA_ROOT" ]; then
    echo "Error: IDA root directory not found."
    exit 1
fi  

# Base directory to search
BASE_DIR="$IDA_ROOT/nextcloud"

# Exclude directories
EXCLUDE_DIRS=(
    "$IDA_ROOT/nextcloud/3rdparty"
    "$IDA_ROOT/nextcloud/apps/idaui-cleanup"
)

# Build the find exclude arguments
EXCLUDE_ARGS=()
for dir in "${EXCLUDE_DIRS[@]}"; do
    EXCLUDE_ARGS+=(-path "$dir" -prune -o)
done

# Execute the find command with exclusions and extract translations
find "$BASE_DIR" \
    "${EXCLUDE_ARGS[@]}" \
    \( -name "*.js" -o -name "*.php" \) -type f -exec \
    grep -Eho "t\(['\"]ida['\"],\s*['\"][^'\"]+['\"]\)" {} + | \
    sed -E "s/^t\(['\"]ida['\"],\s*['\"]([^'\"]+)['\"]\)/\1/" | \
    sort -u > $IDA_ROOT/nextcloud/apps/ida/src/l10n/utils/translated_strings.txt

